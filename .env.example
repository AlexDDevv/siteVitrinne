# ---------------------------------------------------------------------------
# Resend — envoi des emails du formulaire de contact
# Clé API : https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur des emails. Doit appartenir à un domaine vérifié dans Resend.
# En test, "onboarding@resend.dev" fonctionne sans domaine vérifié.
CONTACT_FROM_EMAIL="Site Alexis Delporte <contact@alexisdelporte.fr>"

# Destinataire des messages du formulaire.
CONTACT_TO_EMAIL=alexddevs@gmail.com

# URL publique du site (metadata, sitemap, canonical, og:image).
NEXT_PUBLIC_SITE_URL=https://alexisdelporte.fr
